---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, postUrl, url, ymd, plainText } from '../../lib/posts';
import { SITE } from '../../site.config';
import { enhanceReadingHtml } from '../../lib/reading';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const description = plainText(post.body).slice(0, 140);
// 독서 기록 글은 색·형광펜·권수를 자동으로 입혀서 보여 줍니다. (사진이 들어 있으면 일반 글처럼 보여 줍니다.)
const html = post.rendered?.html;
const reading = post.id === SITE.readingPostId && html && !html.includes('__ASTRO_IMAGE_') ? enhanceReadingHtml(html) : null;
---
<Base title={post.data.title} description={description || undefined}>
  <article>
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{ymd(post.data.date).full}</time>
        <a href={`${url('/posts/')}?c=${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
      </div>
    </header>
    {reading ? <div class="prose reading" set:html={reading} /> : <div class="prose"><Content /></div>}
    {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((t) => <span>#{t}</span>)}</div>}
  </article>
  <nav class="pager">
    {older && <a class="prev" href={postUrl(older.id)}><small>← 이전 글</small>{older.data.title}</a>}
    {newer && <a class="next" href={postUrl(newer.id)}><small>다음 글 →</small>{newer.data.title}</a>}
  </nav>
</Base>
