---
import Base from '../../layouts/Base.astro';
import { getPosts, postUrl, url, ymd } from '../../lib/posts';
const posts = await getPosts();
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const cats = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const years = [...new Set(posts.map((p) => ymd(p.data.date).y))];
---
<Base title="글">
  <h1>글</h1>
  <p class="lead">전체 {posts.length}개</p>
  <input id="q" type="search" placeholder="제목, 본문, 태그 검색" autocomplete="off" data-index={url('/search.json')} />
  <div class="chips" id="cats">
    <button type="button" data-c="" aria-pressed="true">전체 {posts.length}</button>
    {cats.map(([c, n]) => <button type="button" data-c={c} aria-pressed="false">{c} {n}</button>)}
  </div>
  <p class="bar" id="count"></p>
  {years.map((y) => (
    <section data-year>
      <div class="section-title"><span>{y}</span></div>
      <ul class="posts short">
        {posts.filter((p) => ymd(p.data.date).y === y).map((p) => (
          <li data-id={p.id} data-c={p.data.category} data-t={(p.data.title + ' ' + p.data.tags.join(' ')).toLowerCase()}>
            <a href={postUrl(p.id)}><span class="d">{ymd(p.data.date).m}.{ymd(p.data.date).d}</span><span>{p.data.title}</span><span class="c">{p.data.category}</span></a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="none" id="none" hidden>조건에 맞는 글이 없습니다.</p>
</Base>
<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('li[data-id]')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#cats button')];
  let cat = new URLSearchParams(location.search).get('c') ?? '';
  if (!buttons.some((b) => b.dataset.c === cat)) cat = '';
  let body: Record<string, string> | null = null;
  let loading = false;
  async function loadIndex() {
    if (body || loading) return;
    loading = true;
    try { body = await (await fetch(q.dataset.index!)).json(); draw(); } catch { /* 제목 검색만 동작 */ }
  }
  function draw() {
    const k = q.value.trim().toLowerCase();
    let n = 0;
    for (const li of items) {
      const ok = (!cat || li.dataset.c === cat) && (!k || li.dataset.t!.includes(k) || (body?.[li.dataset.id!] ?? '').includes(k));
      li.hidden = !ok;
      if (ok) n++;
    }
    for (const s of document.querySelectorAll<HTMLElement>('section[data-year]')) s.hidden = !s.querySelector('li:not([hidden])');
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.c === cat));
    document.getElementById('count')!.textContent = k || cat ? `${n}개` : '';
    document.getElementById('none')!.hidden = n > 0;
  }
  q.addEventListener('focus', loadIndex);
  q.addEventListener('input', () => { loadIndex(); draw(); });
  document.getElementById('cats')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    cat = b.dataset.c ?? '';
    history.replaceState(null, '', cat ? `?c=${encodeURIComponent(cat)}` : location.pathname);
    draw();
  });
  draw();
</script>
