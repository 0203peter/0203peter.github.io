---
import Base from '../layouts/Base.astro';
import ReadingBoard from '../components/ReadingBoard.astro';
import { SITE } from '../site.config';
import { getPosts, postUrl, url, ymd } from '../lib/posts';
const posts = await getPosts();
const recent = posts.slice(0, 10);
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const cats = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---
<Base>
  <ReadingBoard />
  <h1>{SITE.author}</h1>
  <p class="lead">{SITE.intro}</p>

  <div class="section-title"><span>분류</span></div>
  <div class="chips">
    {cats.map(([c, n]) => <a href={`${url('/posts/')}?c=${encodeURIComponent(c)}`}>{c} {n}</a>)}
  </div>

  <div class="section-title"><span>최근 글</span><a href={url('/posts/')}>전체 {posts.length}개 →</a></div>
  <ul class="posts">
    {recent.map((p) => (
      <li><a href={postUrl(p.id)}><span class="d">{ymd(p.data.date).full}</span><span>{p.data.title}</span><span class="c">{p.data.category}</span></a></li>
    ))}
  </ul>
</Base>
